# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Credentials (Get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Whitelist Security: Your personal mobile phone number (E.164 format: +1XXXXXXXXXX)
# ChipAI will ONLY respond to and text this number!
USER_PHONE_NUMBER=+1XXXXXXXXXX

# User Timezone for calculating relative times like "in 20 minutes" or "at 5pm"
# Examples: America/Chicago, America/New_York, America/Los_Angeles, etc.
USER_TIMEZONE=America/Chicago

# Server Port
PORT=8000

# Verizon SMS/MMS Gateway & SMTP Email Settings (Free text delivery)
# For Verizon MMS (up to ~3,000 characters in a single message): 6822331191@vzwpix.com
# For Verizon SMS (capped at 160 chars): 6822331191@vtext.com
SMS_GATEWAY_EMAIL=6822331191@vzwpix.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_TLS=true
SMTP_FROM=your_email@gmail.com
