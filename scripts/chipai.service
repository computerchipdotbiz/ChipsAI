[Unit]
Description=Sarahzine 800 - ChipAI 24/7 Companion and Personal Assistant
After=network.target

[Service]
Type=simple
User=sarah
WorkingDirectory=/opt/chipai
EnvironmentFile=/opt/chipai/.env
ExecStart=/opt/chipai/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
